# ==========================================================================
# berserkv5 — نمونه فایل تنظیمات محیطی
# این فایل را کپی کن به .env و مقادیر واقعی رو جایگزین کن:
#   cp .env.example .env
# سپس .env رو ویرایش کن. هیچ‌وقت .env واقعی رو به گیت‌هاب پوش نکن.
# ==========================================================================

# --- الزامی ---
BOT_TOKEN=
# یک یا چند آیدی عددی ادمین، با کاما جدا شده
ADMIN_ID=

# --- امنیت پنل ادمین ---
# دستور مخفی به‌جای /admin (بدون اسلش وارد کن)
ADMIN_COMMAND=panel_secret
# اختیاری: اگر خالی باشد همه‌ی ADMIN_ID به‌عنوان owner هم در نظر گرفته می‌شوند
OWNER_ID=

# --- دیتابیس ---
# روی Railway حتماً روی یک Volume mount شده باشد (مثلاً /data/berserk.db)
# روی سرور خودت هم بهتره خارج از دایرکتوری کد باشه تا با آپدیت کد پاک نشه
DB_PATH=berserk.db

# --- رفرال ---
REF_REWARD=30000
MAX_TOTAL_REFERRALS=50
MAX_REFERRALS_PER_DAY=10

# --- Broadcast و بکاپ خودکار ---
BROADCAST_DELAY=0.08
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=30

# --- تأمین‌کننده YouPanel (اختیاری، در صورت نیاز) ---
YOUPANEL_BASE_URL=
YOUPANEL_USERNAME=
YOUPANEL_PASSWORD=
YOUPANEL_TIMEOUT_SECONDS=20
YOUPANEL_VERIFY_SSL=true
YOUPANEL_INBOUNDS_JSON={"vless":["RTL-1","VLESS + WS","tcp","TUN"]}

# --- تأمین‌کننده(های) PasarGuard ---
# یک آرایه‌ی JSON؛ هر آیتم یک پنل مجزا و قابل‌انتخاب در ویزارد پلن می‌سازد.
# می‌تونی هم پنل اصلی و هم هر پنل دیگه‌ای که بعداً اضافه کردی رو همزمان اینجا بذاری.
# group_ids را از خودِ پنل، بخش Groups بردار (پاسارگارد v3+ دیگر بر پایه‌ی
# اسم inbound کار نمی‌کند؛ کاربر به یک یا چند Group وصل می‌شود).
# نکته: کوتیشن‌های داخلی رو دست نخور، این باید یک خط تک JSON معتبر باشه.
PASARGUARD_PANELS_JSON=[{"key":"pasarguard_main","label":"پنل اصلی","base_url":"https://YOUR_PANEL_DOMAIN_OR_IP","username":"admin","password":"CHANGE_ME","group_ids":[1],"verify_ssl":true,"timeout":20}]

# --- اکانت تست رایگان ---
TRIAL_PROVIDER_KEY=youpanel
TRIAL_ENABLED=true
TRIAL_SIZE_MB=200
TRIAL_DAYS=1
TRIAL_MAX_DEVICES=1

# --- بکاپ خودکار پنل PasarGuard (دیتابیس + کانفیگ‌ها -> تلگرام) ---
# پیش‌فرض خاموشه. اگر بات و پنل روی یک سرورن (وضعیت فعلی)، MODE=local کافیه.
# اگر بعداً پنل رو جدا کردی، MODE=ssh رو با اطلاعات زیرش فعال کن (نیاز به
# نصب پکیج asyncssh هم داره: pip install asyncssh).
PASARGUARD_BACKUP_ENABLED=false
PASARGUARD_BACKUP_MODE=local
# دستور بکاپ رو خودت متناسب با نام کانتینر/مسیر compose واقعی‌ت بنویس؛
# آخرین خط چاپ‌شده‌ی این دستور باید مسیر کامل فایل نهایی باشه. مثال:
# PASARGUARD_BACKUP_COMMAND=OUT=/root/pasarguard-backups/pg_$(date +%Y%m%d_%H%M%S).tar.gz && docker exec pasarguard-db pg_dump -U pasarguard pasarguard > /tmp/pg.sql && tar czf "$OUT" /tmp/pg.sql /opt/pasarguard/.env /opt/pasarguard/docker-compose.yml && rm -f /tmp/pg.sql && echo "$OUT"
PASARGUARD_BACKUP_COMMAND=
PASARGUARD_BACKUP_DIR=/root/pasarguard-backups
PASARGUARD_BACKUP_RETENTION_COUNT=14
PASARGUARD_BACKUP_INTERVAL_SECONDS=86400
# فقط برای MODE=ssh لازمه:
PASARGUARD_BACKUP_SSH_HOST=
PASARGUARD_BACKUP_SSH_PORT=22
PASARGUARD_BACKUP_SSH_USER=root
PASARGUARD_BACKUP_SSH_KEY_PATH=
